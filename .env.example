# arXiv Research Assistant Environment Variables

# === Required ===
GROQ_API_KEY=your_groq_api_key_here
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b
GROQ_MODEL_2=openai/gpt-oss-20b

# === Evaluation Judge (Optional - Google Gemini Flash) ===
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# === Infrastructure (Optional - defaults work out of the box) ===
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=arxiv_papers
ES_URL=http://localhost:9200
ES_INDEX=arxiv_papers

# === LLM Settings (Optional) ===
# GROQ_MAX_TOKENS=8192
GROQ_TEMPERATURE=0.7

# === Retrieval Settings (Optional) ===
# Cross-encoder rerank is off by default: loading it on Render free RAM kills paper queries.
RERANKER_ENABLED=false
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_TOP_K=5
RRF_K=60

# === Web Search (Optional) ===
TAVILY_API_KEY=your_tavily_api_key_here

# === Observability (Optional) ===
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# === Frontend (Optional) ===
ALLOWED_ORIGINS=http://localhost:3000
DEBUG=false
