# arXiv Research Assistant Environment Variables

# === Required ===
NVIDIA_NIM_API_KEY=your_nvidia_nim_api_key_here
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_NIM_MODEL=openai/gpt-oss-120b

# === Infrastructure (Optional - defaults work out of the box) ===
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=arxiv_papers
ES_URL=http://localhost:9200
ES_INDEX=arxiv_papers

# === LLM Settings (Optional) ===
NVIDIA_NIM_MAX_TOKENS=2048
NVIDIA_NIM_TEMPERATURE=0.7

# === Retrieval Settings (Optional) ===
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_TOP_K=5
RRF_K=60

# === Web Search (Optional) ===
TAVILY_API_KEY=your_tavily_api_key_here

# === Observability (Optional) ===
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# === Frontend (Optional) ===
ALLOWED_ORIGINS=http://localhost:3000
DEBUG=false
